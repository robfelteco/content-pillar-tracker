# ─── Content Pillar Tracker — environment ──────────────────────────────────
# Copy to .env (already gitignored) and fill in. In production these live as
# Vercel Environment Variables. NEVER commit real secrets.

# Database (Neon Postgres). Use the POOLED connection string for the app.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# X (Twitter) API — OAuth 1.0a user context. Read+own-account access; user
# context is required for real impression_count and any non_public_metrics.
TWITTER_CONSUMER_KEY=""
TWITTER_CONSUMER_SECRET=""
TWITTER_ACCESS_TOKEN=""
TWITTER_ACCESS_TOKEN_SECRET=""

# The account we track (no leading @).
X_ACCOUNT_HANDLE=

# Shown in the header and browser title.
NEXT_PUBLIC_BRAND_NAME=

# Optional: override the assumed X per-read cost for the cost meter (USD).
# Current official pay-per-use rate is ~$0.005; default matches that.
X_API_COST_PER_READ_USD="0.005"

# Anthropic — Stage-2 classification (claude-sonnet-4-6, multimodal).
ANTHROPIC_API_KEY=""

# Google OAuth (NextAuth v5). Sign-in is restricted to this Google Workspace
# domain (required, e.g. yourcompany.com).
AUTH_ALLOWED_DOMAIN=
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Random 32+ char secret: `openssl rand -base64 32`
AUTH_SECRET=""
# In production set to the deployed URL, e.g. https://your-tracker.vercel.app
# NEXTAUTH_URL="http://localhost:3000"

# Protects the daily /api/sync cron route. `openssl rand -hex 32`
CRON_SECRET=""

# --- Quote discovery (Migration 007) ----------------------------------------
# Gemini — YouTube lane. Videos are passed as a fileUri part; Gemini does the
# diarized transcript and the quote extraction. Public videos only.
GEMINI_API_KEY=
# Video reading is 3.x-only and requires a PAID tier. 2.5-flash accepts a YouTube
# URL and silently ignores it, so the lane hard-fails rather than fabricate.
GEMINI_VIDEO_MODEL=gemini-3.6-flash
GEMINI_TEXT_MODEL=gemini-2.5-flash
# Fallbacks tried when the primary video model is saturated (503s are common).
# EVERY model here must actually read video — one that returns 200 without
# ingesting is worse than a failure. gemini-3-flash-preview is NOT one.
GEMINI_VIDEO_FALLBACKS=gemini-3.7-flash,gemini-3.5-flash

# YouTube Data API — used ONLY for cheap listing (channel uploads since a date).
# Gemini does all comprehension. Without this the YouTube lane can't enumerate
# channels and reports itself as failed rather than silently returning nothing.
YOUTUBE_API_KEY=

# Firecrawl — web lane (institutional reports, earnings transcripts, show
# notes). Without it the web lane is skipped with a warning, not an error.
FIRECRAWL_API_KEY=

# xAI — Grok web+X search, used by the broad-educational Discover lane.
XAI_API_KEY=

# --- Draft copy generation backend ------------------------------------------
# COPY_BACKEND=cli  → spawn the local `claude` CLI, billed to the Claude Code
#                     subscription instead of API credits. Local only.
# COPY_BACKEND=api  → the Anthropic API, billed to ANTHROPIC_API_KEY.
# Unset: "api" when running on Vercel, "cli" everywhere else.
#COPY_BACKEND="cli"
# Path to the claude binary, if it is not on the dev server's PATH.
#CLAUDE_BIN="/Users/you/.local/bin/claude"
# Model for the drafter, used by both backends. Default claude-sonnet-4-6.
#COPY_MODEL="claude-sonnet-5"
# CLI wall-clock ceiling in ms. Default 300000.
#COPY_CLI_TIMEOUT_MS="300000"
